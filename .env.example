APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional AI check on scans (Google Gemini). Off by default.
AI_TEXT_CHECK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional "Show page preview" button on link scans (urlscan.io, free key). Off by default.
# The link is sent to urlscan.io as an unlisted scan when someone clicks the button.
# URLSCAN_VISIBILITY can be unlisted (1,000/day free) or private (50/day free); it is never public.
PAGE_PREVIEW=false
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=unlisted
PAGE_PREVIEW_DAILY_CAP=200
PAGE_PREVIEW_KEEP_DAYS=7

# Optional floating Safety Adviser chat (Groq). Off by default. Needs a key and a model name.
CHATBOT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
# Example model name: openai/gpt-oss-120b (check the models your Groq key can use)

# PhishCore scan services. Every key is optional: a check without its key is skipped.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
OCR_SPACE_API_KEY=
ABSTRACTAPI_PHONE_KEY=
OCR_SPACE_API_KEY=
# Backup screenshot reader on this server when OCR.space is busy (needs: sudo apt install tesseract-ocr)
OCR_BACKUP_ENABLED=false
# Where the "Email BruCERT" button on an investigation sends the report. BruCERT handles takedowns, not PhishCore.
# Leave empty to open the email with the To box blank.
BRUCERT_EMAIL=